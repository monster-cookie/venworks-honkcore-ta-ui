<?xml version="1.0" encoding="utf-8"?>
<venworksCUI schemaVersion="1" runtimeVersion="1" designWidth="1920" designHeight="1080"
             safeLeft="64" safeTop="36" safeRight="64" safeBottom="36">
  <definitions>
    <meterStyle id="probe.health" renderer="triangles"
                fillColor="#00BFC4" emptyColor="#123E42"
                fillOpacity="1" emptyOpacity="0.72" segmentCount="14" gap="2"
                direction="right" partialSegments="true" trianglePattern="alternating" />
    <meterStyle id="probe.oxygen" renderer="segments"
                fillColor="#F12CE8" emptyColor="#4A214A"
                fillOpacity="1" emptyOpacity="0.72" segmentCount="16" gap="2"
                direction="right" partialSegments="true" />
    <meterStyle id="probe.encumbrance" renderer="segments"
                fillColor="#16AE32" emptyColor="#123E20"
                fillOpacity="1" emptyOpacity="0.7" segmentCount="8" gap="1"
                direction="right" partialSegments="false" />
  </definitions>
  <vanillaVisibility>
    <target id="bottomLeft" visibleWhen="never" />
    <target id="playerStatus" visibleWhen="never" />
  </vanillaVisibility>
  <includes>
    <include id="chronomark.environment-status" src="environment-status.xml"
             x="0" y="0" anchor="bottom-left" visible="true" visibleWhen="always" z="100" />
    <include id="chronomark.player-meters" src="player-meters.xml"
             x="0" y="0" anchor="bottom-left" visible="true" visibleWhen="always" z="101" />
    <include id="chronomark.weapon-status" src="weapon-status.xml"
             x="0" y="0" anchor="bottom-left" visible="true" visibleWhen="always" z="102" />
  </includes>
  <components />
</venworksCUI>
