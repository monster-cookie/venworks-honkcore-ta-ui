<?xml version="1.0" encoding="utf-8"?>
<venworksCUI schemaVersion="1" runtimeVersion="1" designWidth="1920" designHeight="1080"
             safeLeft="64" safeTop="36" safeRight="64" safeBottom="36">
  <definitions>
    <meterStyle id="composition.continuous" renderer="continuous"
                fillColor="#35E6E6" emptyColor="#183B48"
                fillOpacity="1" emptyOpacity="0.7" />
    <template id="composition.card">
      <group id="root" x="0" y="0" width="360" height="116" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="0">
        <panel id="panel" x="0" y="0" width="360" height="116" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="0"
               fillColor="#071923" fillOpacity="0.94" strokeColor="#35E6E6" strokeOpacity="0.9" strokeWidth="2" />
        <text id="title" x="18" y="13" width="324" height="30" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="1"
              value="CARD TEMPLATE" font="$MAIN_Font_Bold" fontSize="18" color="#F7FCFF" bold="false" align="left" />
        <meter id="meter" x="18" y="58" width="276" height="18" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="1"
               style="composition.continuous" value="50" max="100" />
        <shape id="badge" x="314" y="52" width="28" height="28" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="2"
               shape="ellipse" fillColor="#35E6E6" fillOpacity="0.85" strokeColor="#F7FCFF" strokeOpacity="1" strokeWidth="1" />
        <text id="caption" x="18" y="84" width="324" height="24" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="1"
              value="INSTANCE OVERRIDES: TEXT / METER / VISIBLE" font="$MAIN_Font_Bold" fontSize="12" color="#35E6E6" bold="false" align="left" />
      </group>
    </template>
    <template id="composition.row">
      <group id="root" x="0" y="0" width="236" height="52" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="0">
        <panel id="panel" x="0" y="0" width="236" height="52" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="0"
               fillColor="#102C38" fillOpacity="0.92" strokeColor="#35E6E6" strokeOpacity="0.65" strokeWidth="1" />
        <text id="label" x="12" y="11" width="212" height="30" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="1"
              value="REPEATER ITEM" font="$MAIN_Font_Bold" fontSize="15" color="#F7FCFF" bold="false" align="center" />
      </group>
    </template>
    <template id="composition.state.normal">
      <group id="root" x="0" y="0" width="480" height="116" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="0">
        <panel id="panel" x="0" y="0" width="480" height="116" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="0"
               fillColor="#071923" fillOpacity="0.94" strokeColor="#35E6E6" strokeOpacity="0.9" strokeWidth="2" />
        <text id="label" x="20" y="32" width="440" height="42" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="1"
              value="STATE: NORMAL" font="$MAIN_Font_Bold" fontSize="21" color="#35E6E6" bold="false" align="center" />
      </group>
    </template>
    <template id="composition.state.warning">
      <group id="root" x="0" y="0" width="480" height="116" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="0">
        <panel id="panel" x="0" y="0" width="480" height="116" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="0"
               fillColor="#29170A" fillOpacity="0.94" strokeColor="#FFB51B" strokeOpacity="1" strokeWidth="2" />
        <text id="label" x="20" y="32" width="440" height="42" opacity="1" visible="true" rotation="0" scaleX="1" scaleY="1" z="1"
              value="STATE: WARNING" font="$MAIN_Font_Bold" fontSize="21" color="#FFB51B" bold="false" align="center" />
      </group>
    </template>
  </definitions>
  <components>
    <instance id="card.left" template="composition.card" x="20" y="18" anchor="top-left" z="100">
      <override target="title" text="TEMPLATE INSTANCE: LEFT" />
      <override target="meter" meterValue="25" />
    </instance>
    <state id="state.gallery" selected="warning" x="0" y="18" anchor="top-center" z="100">
      <option name="normal" template="composition.state.normal" />
      <option name="warning" template="composition.state.warning">
        <override target="label" text="STATE: WARNING SELECTED" />
      </option>
    </state>
    <instance id="card.right" template="composition.card" x="-20" y="18" anchor="top-right" z="100">
      <override target="title" text="TEMPLATE INSTANCE: RIGHT" />
      <override target="meter" meterValue="75" />
      <override target="badge" visible="false" />
    </instance>
    <repeater id="repeat.vertical" template="composition.row" x="20" y="0" width="236" height="180"
              anchor="center-left" visible="true" z="100" flow="vertical" gapX="0" gapY="12" columns="1">
      <item id="alpha"><override target="label" text="VERTICAL: ALPHA" /></item>
      <item id="hidden" visible="false"><override target="label" text="THIS ITEM COLLAPSES" /></item>
      <item id="beta"><override target="label" text="VERTICAL: BETA" /></item>
      <item id="gamma"><override target="label" text="VERTICAL: GAMMA" /></item>
    </repeater>
    <repeater id="repeat.grid" template="composition.row" x="0" y="20" width="490" height="116"
              anchor="center" visible="true" z="100" flow="grid" gapX="18" gapY="12" columns="2">
      <item id="one"><override target="label" text="GRID: ONE" /></item>
      <item id="two"><override target="label" text="GRID: TWO" /></item>
      <item id="three"><override target="label" text="GRID: THREE" /></item>
      <item id="four"><override target="label" text="GRID: FOUR" /></item>
    </repeater>
    <repeater id="repeat.horizontal" template="composition.row" x="0" y="-20" width="744" height="52"
              anchor="bottom-center" visible="true" z="100" flow="horizontal" gapX="18" gapY="0" columns="1">
      <item id="left"><override target="label" text="HORIZONTAL: LEFT" /></item>
      <item id="center"><override target="label" text="HORIZONTAL: CENTER" /></item>
      <item id="right"><override target="label" text="HORIZONTAL: RIGHT" /></item>
    </repeater>
  </components>
</venworksCUI>
