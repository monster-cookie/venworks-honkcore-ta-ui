<?xml version="1.0" encoding="utf-8"?>
<venworksCUI schemaVersion="1" runtimeVersion="1" designWidth="1920" designHeight="1080"
             safeLeft="64" safeTop="36" safeRight="64" safeBottom="36">
  <definitions>
    <meterStyle id="probe.health.empty" renderer="triangles"
                fillColor="#123E42" emptyColor="#123E42"
                fillOpacity="0.72" emptyOpacity="0.72" segmentCount="14" gap="2"
                direction="right" partialSegments="false" trianglePattern="alternating" />
    <meterStyle id="probe.health.live" renderer="triangles"
                fillColor="#00BFC4" emptyColor="#00BFC4"
                fillOpacity="1" emptyOpacity="0" segmentCount="14" gap="2"
                direction="right" partialSegments="true" trianglePattern="alternating" />
    <meterStyle id="probe.oxygen.empty" renderer="segments"
                fillColor="#4A214A" emptyColor="#4A214A"
                fillOpacity="0.72" emptyOpacity="0.72" segmentCount="16" gap="2"
                direction="right" partialSegments="false" />
    <meterStyle id="probe.oxygen.live" renderer="segments"
                fillColor="#F12CE8" emptyColor="#F12CE8"
                fillOpacity="1" emptyOpacity="0" segmentCount="16" gap="2"
                direction="right" partialSegments="true" />
    <meterStyle id="probe.encumbrance" renderer="segments"
                fillColor="#16AE32" emptyColor="#123E20"
                fillOpacity="1" emptyOpacity="0.7" segmentCount="8" gap="1"
                direction="right" partialSegments="false" />
  </definitions>
  <vanillaVisibility>
    <target id="bottomLeft" visibleWhen="never" />
  </vanillaVisibility>
  <components>
    <group id="chronomark.probe" x="0" y="0" width="430" height="370" opacity="1" visible="true" visibleWhen="always"
           rotation="0" scaleX="1" scaleY="1" z="100" anchor="bottom-left">
      <text id="chronomark.weapon.placeholder" x="8" y="0" width="414" height="27" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="1"
            value="WEAPON NAME [PROVIDER REQUIRED]" font="$MAIN_Font_Bold" fontSize="16" color="#F2F7F9" bold="false" align="left" />
      <text id="chronomark.ammo.clip" x="8" y="26" width="52" height="30" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="1" source="weapon.clipammo" format="integer"
            value="--" font="$MAIN_Font_Bold" fontSize="22" color="#F2F7F9" bold="true" align="right" />
      <text id="chronomark.ammo.separator" x="64" y="26" width="18" height="30" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="1"
            value="/" font="$MAIN_Font_Bold" fontSize="22" color="#F2F7F9" bold="true" align="center" />
      <text id="chronomark.ammo.reserve" x="84" y="26" width="60" height="30" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="1" source="weapon.reserveammo" format="integer"
            value="--" font="$MAIN_Font_Bold" fontSize="22" color="#F2F7F9" bold="true" align="left" />
      <text id="chronomark.ammo.type.placeholder" x="146" y="29" width="270" height="26" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="1"
            value="(AMMO TYPE PROVIDER REQUIRED)" font="$MAIN_Font_Bold" fontSize="13" color="#93A9AD" bold="false" align="left" />

      <panel id="chronomark.panel" x="0" y="60" width="430" height="214" opacity="1" visible="true"
             rotation="0" scaleX="1" scaleY="1" z="0"
             fillColor="#061B22" fillOpacity="0.86" strokeColor="#00BFC4" strokeOpacity="0.58" strokeWidth="1" />
      <divider id="chronomark.panel.topline" x="12" y="72" width="406" height="0" opacity="1" visible="true"
               rotation="0" scaleX="1" scaleY="1" z="1" color="#00BFC4" strokeOpacity="0.8" strokeWidth="2" />
      <text id="chronomark.location" x="16" y="78" width="286" height="34" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2" source="location.name" format="raw"
            value="LOCATION WAITING FOR PROVIDER" font="$MAIN_Font_Bold" fontSize="22" color="#00E8EC" bold="false" align="left" />
      <text id="chronomark.time" x="310" y="82" width="102" height="27" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2" source="environment.localtime" format="time24"
            value="--:--" font="$MAIN_Font_Bold" fontSize="15" color="#00E8EC" bold="false" align="right" />

      <text id="chronomark.environment.oxygen.label" x="16" y="116" width="26" height="25" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2"
            value="O2" font="$MAIN_Font_Bold" fontSize="15" color="#F2F7F9" bold="false" align="left" />
      <text id="chronomark.environment.oxygen" x="44" y="116" width="54" height="25" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2" source="environment.oxygenpercentage" format="percent"
            value="--%" font="$MAIN_Font_Bold" fontSize="15" color="#F2F7F9" bold="false" align="left" />
      <text id="chronomark.environment.temperature" x="104" y="116" width="78" height="25" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2" source="environment.temperature" format="temperature"
            value="--°" font="$MAIN_Font_Bold" fontSize="15" color="#F2F7F9" bold="false" align="left" />
      <text id="chronomark.environment.gravity" x="186" y="116" width="92" height="25" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2" source="environment.gravity" format="gravity"
            value="--.--g" font="$MAIN_Font_Bold" fontSize="15" color="#F2F7F9" bold="false" align="left" />

      <text id="chronomark.power" x="16" y="158" width="250" height="27" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2" source="power.key" format="raw"
            value="NO ACTIVE POWER" font="$MAIN_Font_Bold" fontSize="16" color="#00E8EC" bold="false" align="left" />
      <text id="chronomark.carry.placeholder" x="16" y="188" width="250" height="25" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2"
            value="CARRY [PROVIDER REQUIRED]" font="$MAIN_Font_Bold" fontSize="15" color="#00E8EC" bold="false" align="left" />
      <text id="chronomark.credits.placeholder" x="236" y="188" width="176" height="25" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2"
            value="CREDITS [PROVIDER REQUIRED]" font="$MAIN_Font_Bold" fontSize="15" color="#F2B41C" bold="false" align="right" />
      <text id="chronomark.provider.note" x="16" y="232" width="396" height="27" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2"
            value="GOAL 5 PROVIDER PROBE — REPORT VALUES, NOT STYLING" font="$MAIN_Font_Bold" fontSize="12" color="#93A9AD" bold="false" align="left" />

      <meter id="chronomark.health.empty" x="8" y="286" width="344" height="26" opacity="1" visible="true"
             rotation="0" scaleX="1" scaleY="1" z="1" style="probe.health.empty" value="0" max="100" />
      <meter id="chronomark.health.live" x="8" y="286" width="344" height="26" opacity="1" visible="true"
             rotation="0" scaleX="1" scaleY="1" z="2" style="probe.health.live" value="100" max="100"
             source="player.health" maxSource="player.maxhealth" />
      <meter id="chronomark.oxygen.empty" x="8" y="320" width="344" height="20" opacity="1" visible="true"
             rotation="0" scaleX="1" scaleY="1" z="1" style="probe.oxygen.empty" value="0" max="100" />
      <meter id="chronomark.oxygen.live" x="8" y="320" width="344" height="20" opacity="1" visible="true"
             rotation="0" scaleX="1" scaleY="1" z="2" style="probe.oxygen.live" value="100" max="100"
             source="player.oxygen" maxSource="player.maxoxygen" />
      <meter id="chronomark.encumbrance.placeholder" x="8" y="350" width="84" height="14" opacity="1" visible="true"
             rotation="0" scaleX="1" scaleY="1" z="1" style="probe.encumbrance" value="3" max="8" />
      <text id="chronomark.health.percentage" x="360" y="285" width="62" height="25" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2" source="player.healthpercentage" format="percent"
            value="--%" font="$MAIN_Font_Bold" fontSize="13" color="#00E8EC" bold="false" align="right" />
      <text id="chronomark.oxygen.percentage" x="360" y="317" width="62" height="25" opacity="1" visible="true"
            rotation="0" scaleX="1" scaleY="1" z="2" source="player.oxygenpercentage" format="percent"
            value="--%" font="$MAIN_Font_Bold" fontSize="13" color="#F12CE8" bold="false" align="right" />
    </group>
  </components>
</venworksCUI>
